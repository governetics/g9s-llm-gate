# LLM gate — example environment for the local docker compose context.
# Copy to .env in the repo root and fill in real values; .env is gitignored.
# Pass it explicitly (compose looks for .env in the project directory deploy/,
# not in the root -- a root .env without --env-file fails loudly on the first
# required key):
#   docker compose --env-file .env -f deploy/compose.yml up -d
# Provider API keys (Kimi / Z.ai) are NOT set here: they are entered in the
# LiteLLM Admin UI and stored encrypted in the database.
# On the governetics panel the LLM_GATE_* keys above are entered in the
# project's Configure step instead.

# Address the proxy port is published on. Local: 127.0.0.1 (nothing leaves
# the machine). Remote: an address the g9s-edge reverse proxy can reach --
# the host loopback is NOT reachable from edge.
LLM_GATE_BIND=127.0.0.1

# Host port of the proxy (the container port is fixed at 4000).
LLM_GATE_PORT=4000

# LiteLLM master key: the `sk-` prefix is required by LiteLLM. Also the
# initial Admin UI login until a DB admin user takes over. Generate one:
#   python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LLM_GATE_MASTER_KEY=sk-REPLACE-ME

# Salt key encrypting provider credentials in the database. NOT rotatable:
# losing it loses every stored credential. Generate once, keep with DB
# backups. Any long random string works:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_GATE_SALT_KEY=REPLACE-ME

# Postgres password for the `llmgate` user. URL-safe charset only (letters
# and digits): the value is embedded verbatim into the database URL, special
# characters would break the DSN. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
LLM_GATE_POSTGRES_PASSWORD=REPLACE-ME
